# Exemplo de variáveis. O Django não carrega este arquivo automaticamente.
# Defina as variáveis no terminal, serviço de hospedagem ou use uma biblioteca dotenv.
DB_ENGINE=postgres
DB_NAME=nextask
DB_USER=postgres
DB_PASSWORD=defina-sua-senha
DB_HOST=127.0.0.1
DB_PORT=5432

DJANGO_SECRET_KEY=gere-uma-chave-aleatoria-forte
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=seu-dominio.com,localhost,127.0.0.1
